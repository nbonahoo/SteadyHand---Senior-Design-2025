<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="SeniorDesign.GraphDetailPage"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <Color x:Key="HeaderBlue">#0A3D91</Color>
        <Color x:Key="PrimaryBlue">#1565C0</Color>
        <Color x:Key="TextDark">#212121</Color>
        <Color x:Key="CardBackground">#FFFFFF</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- HEADER -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource HeaderBlue}"
              Padding="20,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- GRAPH TITLE (scaled) -->
            <Label x:Name="GraphTitle"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="{DynamicResource HeaderFontSize}"
                   VerticalOptions="Center"
                   Grid.Column="0" />

            <!-- FONT SIZE BUTTONS -->
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="10"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End">
                <Button Text="A−"
                    FontAttributes="Bold"
                    Padding="12,4"
                    HorizontalOptions="Start"
                    Clicked="OnDecreaseFont"/>

                <Button Text="A+"
                    FontAttributes="Bold"
                    Padding="12,4"
                    HorizontalOptions="Start"
                    Clicked="OnIncreaseFont"/>

            </HorizontalStackLayout>

            <!-- EXPORT BUTTON -->

        </Grid>

        <!-- STATUS TEXT (scaled body font) -->
        <Label x:Name="ExportStatusLabel"
               Grid.Row="1"
               FontSize="{DynamicResource BodyFontSize}"
               TextColor="{StaticResource TextDark}"
               HorizontalOptions="Center" />

        <!-- CHART -->
        <!-- SCROLLABLE AREA (chart + export button inside together) -->
        <ScrollView Grid.Row="2" Padding="16">

            <VerticalStackLayout Spacing="20">

                <!-- CHART CARD -->
                <Border Stroke="{StaticResource PrimaryBlue}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{StaticResource CardBackground}">
                    <VerticalStackLayout Padding="16">
                        <lvc:CartesianChart x:Name="DetailChart"
                                    HeightRequest="500"
                                    LegendPosition="Hidden"
                                    AnimationsSpeed="0:0:0" />
                    </VerticalStackLayout>
                </Border>

                <!-- EXPORT BUTTON UNDER CHART -->
                <Button Text="Export Data"
                BackgroundColor="{StaticResource PrimaryBlue}"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="{DynamicResource BodyFontSize}"
                CornerRadius="10"
                Padding="16,8"
                HorizontalOptions="Center"
                Clicked="OnExportClicked"/>
            </VerticalStackLayout>

        </ScrollView>


        <!-- FOOTER (scaled small font) -->
        <Grid Grid.Row="3"
              BackgroundColor="{StaticResource HeaderBlue}"
              Padding="10,5">
            <Label Text="2025 Steady Hand Project"
                   TextColor="White"
                   FontSize="{DynamicResource SmallFontSize}"
                   HorizontalOptions="Center" />
        </Grid>

    </Grid>

</ContentPage>
