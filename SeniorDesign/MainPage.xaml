<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="SeniorDesign.MainPage"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <!-- Accessible color palette -->
        <Color x:Key="HeaderBlue">#0A3D91</Color>
        <Color x:Key="PrimaryBlue">#1565C0</Color>
        <Color x:Key="TextDark">#212121</Color>
        <Color x:Key="PageBackground">#FAFAFA</Color>
        <Color x:Key="CardBackground">#FFFFFF</Color>
        <Color x:Key="SecondaryBlue">#1E88E5</Color>
        <Color x:Key="AccentBlueLight">#BBDEFB</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ✅ HEADER BAR -->
        <Grid BackgroundColor="{StaticResource HeaderBlue}"
              Padding="20,10"
              Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Text="Steady Hand"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="28"
                   VerticalOptions="Center"
                   SemanticProperties.Description="Application title: Steady Hand" />
        </Grid>

        <!-- ✅ MAIN SCROLLABLE CONTENT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="20">

                <!-- ✅ GRAPH 1: Hand Shakiness (Acceleration) -->
                <Border Stroke="{StaticResource PrimaryBlue}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}"
                        SemanticProperties.Description="Hand shakiness chart card">
                    <VerticalStackLayout Padding="20" Spacing="10">
                        <Label Text="Hand Shakiness Over Time"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}" />

                        <!-- Grid layout for Y-axis + chart + X-axis -->
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*">
                            <!-- Y Axis -->
                                                       <!-- Chart + X axis -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8"
                                                 HorizontalOptions="FillAndExpand"
                                                 VerticalOptions="FillAndExpand">
                                <lvc:CartesianChart x:Name="ShakinessChart"
                                    Grid.Row="0"
                                    HeightRequest="250"
                                    LegendPosition="Hidden"
                                    AnimationsSpeed="0:0:0"
                                    SemanticProperties.Description="Accessible line chart of hand shakiness over time" />

                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShakinessTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- ✅ GRAPH 2: Hand Temperature -->
                <Border Stroke="{StaticResource PrimaryBlue}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}"
                        SemanticProperties.Description="Hand temperature chart card">
                    <VerticalStackLayout Padding="20" Spacing="10">

                        <!-- Grid layout for Y-axis + chart + X-axis -->
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*">
                            

                            <!-- Chart + X axis -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8"
                                                 HorizontalOptions="FillAndExpand"
                                                 VerticalOptions="FillAndExpand">
                                <lvc:CartesianChart x:Name="TemperatureChart"
                                    HeightRequest="250"
                                    LegendPosition="Hidden"
                                    AnimationsSpeed="0:0:0"
                                    SemanticProperties.Description="Accessible line chart of hand temperature" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTemperatureTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ✅ FOOTER -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource HeaderBlue}" Padding="0,10">
            <Label Text="2025 Steady Hand Project"
                   TextColor="White"
                   FontSize="12"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="Footer with project copyright" />
        </Grid>

    </Grid>
</ContentPage>
