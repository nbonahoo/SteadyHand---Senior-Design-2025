<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:charts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="SeniorDesign.MainPage"
             BackgroundColor="#FAFAFA">

    <ContentPage.Resources>
        <Color x:Key="HeaderBlue">#0A3D91</Color>
        <Color x:Key="PrimaryBlue">#1565C0</Color>
        <Color x:Key="TextDark">#212121</Color>
        <Color x:Key="PageBackground">#FAFAFA</Color>
        <Color x:Key="CardBackground">#FFFFFF</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <!-- HEADER -->
        <Grid BackgroundColor="{StaticResource HeaderBlue}"
      Padding="20,10"
      Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Title -->
            <Label Text="Steady Hand"
           TextColor="White"
           FontAttributes="Bold"
           FontSize="{DynamicResource HeaderFontSize}"
           VerticalOptions="Center"
           Grid.Column="0" />

            <!-- FONT BUTTONS -->
            <HorizontalStackLayout Grid.Column="1"
                           Spacing="10"
                           VerticalOptions="Center"
                           HorizontalOptions="End">

                <Button Text="A−"
                    FontAttributes="Bold"
                    Padding="12,4"
                    HorizontalOptions="Start"
                    Clicked="OnDecreaseFont"/>

                <Button Text="A+"
                    FontAttributes="Bold"
                    Padding="12,4"
                    HorizontalOptions="Start"
                    Clicked="OnIncreaseFont"/>
            </HorizontalStackLayout>
        </Grid>


        <!-- MAIN CONTENT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="20">

                <!-- 🔵 GRAPH 1 -->
                <Border Stroke="{StaticResource PrimaryBlue}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}">
                    <VerticalStackLayout Padding="20" Spacing="10">

                        <!-- USE SCALED TITLE FONT -->
                        <Label Text="Hand Shakiness Over Time"
                               FontSize="{DynamicResource TitleFontSize}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextDark}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*">

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8"
                                                 HorizontalOptions="FillAndExpand"
                                                 VerticalOptions="FillAndExpand">

                                <lvc:CartesianChart x:Name="ShakinessChart"
                                    HeightRequest="250"
                                    LegendPosition="Hidden"
                                    AnimationsSpeed="0:0:0"
                                    SemanticProperties.Description="Hand shakiness chart" />

                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShakinessTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- 🔴 GRAPH 2 -->
                <Border Stroke="{StaticResource PrimaryBlue}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource CardBackground}">
                    <VerticalStackLayout Padding="20" Spacing="10">

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="*">

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8"
                                                 HorizontalOptions="FillAndExpand"
                                                 VerticalOptions="FillAndExpand">

                                <lvc:CartesianChart x:Name="TemperatureChart"
                                    HeightRequest="250"
                                    LegendPosition="Hidden"
                                    AnimationsSpeed="0:0:0"
                                    SemanticProperties.Description="Temperature chart" />

                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTemperatureTapped" />
                    </Border.GestureRecognizers>
                </Border>



            </VerticalStackLayout>
        </ScrollView>

        <!-- FOOTER -->
        <Grid Grid.Row="2"
              BackgroundColor="{StaticResource HeaderBlue}"
              Padding="0,10">

            <!-- USE SCALED SMALL FONT -->
            <Label Text="2025 Steady Hand Project"
                   TextColor="White"
                   FontSize="{DynamicResource SmallFontSize}"
                   HorizontalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
